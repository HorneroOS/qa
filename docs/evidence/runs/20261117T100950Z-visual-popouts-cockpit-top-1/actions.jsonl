{"t": 54.282, "kind": "setup", "run": "cat > \"$HOME/qa-populate.sh\" <<'EOS'\n#!/bin/sh\n# Real content behind the bars: terminals with output, a file manager and a browser-like window when installed.\n# QA captures need windows visible side by side: the product default is the scrolling layout (columns scroll off-screen).\nhyprctl eval 'hl.config({ general = { layout = \"dwindle\" } })' >/dev/null\nrun() { hyprctl eval \"hl.exec_cmd(\\\"$1\\\")\" >/dev/null; }\nrun \"kitty --title QA-Terminal sh -c 'ls --color=always -la /usr/share/hornero | head -30; echo; df -h | head -8; exec sh'\"\nsleep 1\nrun \"kitty --title QA-Monitor sh -c 'top -b -d 2 | head -40; exec sh'\"\nsleep 1\nfor fm in thunar nautilus pcmanfm dolphin; do command -v $fm >/dev/null && { run \"$fm /usr/share/hornero\"; break; }; done\nfor br in firefox chromium epiphany falkon; do command -v $br >/dev/null && { run \"$br --new-window file:///usr/share/doc\"; break; }; done\nsleep 6\nhyprctl clients -j | jq -r '.[].class' | sort | uniq -c > \"$HOME/qa-clients.txt\"\nEOS\nsh \"$HOME/qa-populate.sh\"\n", "rc": 0, "stdout": "", "stderr": ""}
