{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/HorneroOS/qa/schemas/gaming-acceptance.schema.json",
  "title": "HorneroOS Gaming acceptance evidence index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "edition_state",
    "items"
  ],
  "properties": {
    "schema": {
      "const": "hornero.qa.gaming-acceptance/1"
    },
    "edition_state": {
      "enum": [
        "planned"
      ]
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "fixtureManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "id",
        "kind",
        "hardware",
        "software"
      ],
      "properties": {
        "schema": {
          "const": "hornero.qa.studio-fixture/1"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "virtual",
            "physical"
          ]
        },
        "hardware": {
          "type": "object",
          "minProperties": 1
        },
        "software": {
          "type": "object",
          "minProperties": 1
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "outcome",
        "required",
        "condition",
        "enabled",
        "owner_issues",
        "evidence_kind",
        "fixture",
        "status",
        "evidence",
        "review"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "outcome": {
          "type": "string",
          "minLength": 8
        },
        "required": {
          "type": "boolean"
        },
        "condition": {
          "enum": [
            "always",
            "when-enabled"
          ]
        },
        "enabled": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "owner_issues": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+#[0-9]+$"
          }
        },
        "evidence_kind": {
          "enum": [
            "bundle",
            "review"
          ]
        },
        "fixture": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "approved",
            "notes",
            "sha256",
            "manifest"
          ],
          "properties": {
            "id": {
              "type": [
                "string",
                "null"
              ]
            },
            "approved": {
              "type": "boolean"
            },
            "notes": {
              "type": "string"
            },
            "sha256": {
              "anyOf": [
                {
                  "$ref": "#/$defs/digest"
                },
                {
                  "type": "null"
                }
              ]
            },
            "manifest": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            }
          }
        },
        "status": {
          "enum": [
            "pending",
            "partial",
            "unsupported",
            "failed",
            "accepted"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "decision",
            "reference"
          ],
          "properties": {
            "decision": {
              "enum": [
                "pending",
                "accepted",
                "rejected"
              ]
            },
            "reference": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "bundle",
            "review"
          ]
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "reference": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://github\\.com/HorneroOS/"
        },
        "scenario": {
          "type": "string",
          "minLength": 1
        },
        "scenario_sha256": {
          "$ref": "#/$defs/digest"
        },
        "bundle_sha256": {
          "$ref": "#/$defs/digest"
        },
        "pins": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "shell_sha",
            "config_sha",
            "horneroctl_sha256",
            "image_sha256",
            "guest_sha",
            "iso_sha256",
            "manifest_sha256",
            "catalogue_sha256",
            "hardware_fixture",
            "hardware_fixture_sha256"
          ],
          "properties": {
            "shell_sha": {
              "$ref": "#/$defs/sha"
            },
            "config_sha": {
              "$ref": "#/$defs/sha"
            },
            "horneroctl_sha256": {
              "$ref": "#/$defs/digest"
            },
            "image_sha256": {
              "$ref": "#/$defs/digest"
            },
            "guest_sha": {
              "$ref": "#/$defs/sha"
            },
            "iso_sha256": {
              "$ref": "#/$defs/digest"
            },
            "manifest_sha256": {
              "$ref": "#/$defs/digest"
            },
            "catalogue_sha256": {
              "$ref": "#/$defs/digest"
            },
            "hardware_fixture": {
              "type": "string",
              "minLength": 1
            },
            "hardware_fixture_sha256": {
              "$ref": "#/$defs/digest"
            }
          }
        }
      },
      "oneOf": [
        {
          "required": [
            "kind",
            "run_id",
            "scenario",
            "scenario_sha256",
            "bundle_sha256",
            "pins"
          ],
          "properties": {
            "kind": {
              "const": "bundle"
            }
          }
        },
        {
          "required": [
            "kind",
            "reference"
          ],
          "properties": {
            "kind": {
              "const": "review"
            }
          }
        }
      ]
    }
  }
}
